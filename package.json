{
  "name": "ff-product",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "Forever Flowers draft-product tooling for storefront analysis and Shopify draft creation.",
  "scripts": {
    "app:start": "node src/server.mjs",
    "desktop:start": "electron .",
    "desktop:dir": "electron-builder --win dir",
    "desktop:dist": "electron-builder --win nsis",
    "catalog:sample": "node src/cli.mjs catalog-sample",
    "catalog:analyze": "node src/cli.mjs catalog-analyze",
    "shopify:test": "node src/cli.mjs shopify-test",
    "shopify:analyze": "node src/cli.mjs shopify-analyze",
    "draft:dry-run": "node src/cli.mjs draft-dry-run",
    "draft:create": "node src/cli.mjs draft-create"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.elos.ffproduct",
    "productName": "FF Product",
    "asar": true,
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "artifactName": "FF-Product-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
